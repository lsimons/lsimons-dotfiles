# Managed by lsimons-dotfiles

# Use the 1Password SSH agent. Its socket path differs per platform, so
# the IdentityAgent line lives in a file generated by ssh/install.py.
Include config.agent

# Silence PQC warning again
IgnoreUnknown WarnWeakCrypto
WarnWeakCrypto no-pq-kex

# Local overrides: ~/.ssh/config.local
Include config.local
