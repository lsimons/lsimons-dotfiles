# LSD Warm Light — micro colorscheme.
# Colours from colors/lsd-colors.json ("light"), syntax mapping mirrors
# the "LSD Warm Light" theme in zed/lsd-warm.json.symlink.
# Needs a truecolor terminal (COLORTERM=truecolor) or `set truecolor on`.

color-link default "#241100,#faf1f3"
color-link comment "italic #765e44,#faf1f3"
color-link identifier "#0045ae,#faf1f3"
color-link constant "#906d00,#faf1f3"
color-link constant.bool "#906d00,#faf1f3"
color-link constant.number "#006168,#faf1f3"
color-link constant.string "#006248,#faf1f3"
color-link constant.string.char "#006248,#faf1f3"
color-link constant.specialChar "#006168,#faf1f3"
color-link statement "#aa0048,#faf1f3"
color-link symbol "#594329,#faf1f3"
color-link symbol.operator "#241100,#faf1f3"
color-link symbol.brackets "#594329,#faf1f3"
color-link symbol.tag "#aa0048,#faf1f3"
color-link preproc "#aa0048,#faf1f3"
color-link type "#906d00,#faf1f3"
color-link type.extended "default"
color-link special "#006168,#faf1f3"
color-link underlined "underline #006248,#faf1f3"
color-link error "bold #a10000,#faf1f3"
color-link todo "bold #c17a23,#faf1f3"

color-link selection "#241100,#ebd3b4"
color-link hlsearch "#241100,#d4a057"
color-link match-brace "#faf1f3,#c17a23"
color-link cursor-line "#fbecd9"
color-link color-column "#fbecd9"
color-link indent-char "#dbcbb9,#faf1f3"
color-link line-number "#947b60,#faf1f3"
color-link current-line-number "#c17a23,#fbecd9"

color-link statusline "#241100,#ebd3b4"
color-link statusline.inactive "#594329,#f4e6d2"
color-link statusline.suggestions "#241100,#f7f7f7"
color-link tabbar "#3e290f,#f7e9d6"
color-link tabbar.active "bold #241100,#faf1f3"
color-link divider "#dbcbb9,#faf1f3"
color-link scrollbar "#947b60,#faf1f3"
color-link message "#241100,#faf1f3"
color-link error-message "bold #a10000,#faf1f3"

color-link diff-added "#006248"
color-link diff-modified "#906d00"
color-link diff-deleted "#a10000"
color-link gutter-error "#a10000,#faf1f3"
color-link gutter-warning "#906d00,#faf1f3"
color-link tab-error "#faf1f3,#d01c25"
color-link trailingws "#faf1f3,#d01c25"
