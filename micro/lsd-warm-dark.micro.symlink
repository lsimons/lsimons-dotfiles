# LSD Warm Dark — micro colorscheme.
# Colours from colors/lsd-colors.json ("dark"), syntax mapping mirrors
# the "LSD Warm Dark" theme in zed/lsd-warm.json.symlink.
# Needs a truecolor terminal (COLORTERM=truecolor) or `set truecolor on`.

color-link default "#dfcab2,#1a0c00"
color-link comment "italic #6b5b44,#1a0c00"
color-link identifier "#005fc9,#1a0c00"
color-link constant "#eabb79,#1a0c00"
color-link constant.bool "#eabb79,#1a0c00"
color-link constant.number "#007980,#1a0c00"
color-link constant.string "#007a5e,#1a0c00"
color-link constant.string.char "#007a5e,#1a0c00"
color-link constant.specialChar "#007980,#1a0c00"
color-link statement "#c8005e,#1a0c00"
color-link symbol "#8a7761,#1a0c00"
color-link symbol.operator "#dfcab2,#1a0c00"
color-link symbol.brackets "#8a7761,#1a0c00"
color-link symbol.tag "#c8005e,#1a0c00"
color-link preproc "#c8005e,#1a0c00"
color-link type "#eabb79,#1a0c00"
color-link type.extended "default"
color-link special "#007980,#1a0c00"
color-link underlined "underline #007a5e,#1a0c00"
color-link error "bold #c10032,#1a0c00"
color-link todo "bold #d79e59,#1a0c00"

color-link selection "#dfcab2,#3a2b16"
color-link hlsearch "#1a0c00,#d79e59"
color-link match-brace "#1a0c00,#d79e59"
color-link cursor-line "#261704"
color-link color-column "#261704"
color-link indent-char "#2d220f,#1a0c00"
color-link line-number "#6b5b44,#1a0c00"
color-link current-line-number "#d79e59,#261704"

color-link statusline "#dfcab2,#3a2b16"
color-link statusline.inactive "#8a7761,#261704"
color-link statusline.suggestions "#dfcab2,#201301"
color-link tabbar "#8a7761,#1f1000"
color-link tabbar.active "bold #dfcab2,#1a0c00"
color-link divider "#2d220f,#1a0c00"
color-link scrollbar "#5e4c38,#1a0c00"
color-link message "#dfcab2,#1a0c00"
color-link error-message "bold #c10032,#1a0c00"

color-link diff-added "#007a5e"
color-link diff-modified "#eabb79"
color-link diff-deleted "#c10032"
color-link gutter-error "#c10032,#1a0c00"
color-link gutter-warning "#eabb79,#1a0c00"
color-link tab-error "#1a0c00,#c10032"
color-link trailingws "#1a0c00,#c10032"
